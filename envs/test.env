# Environnement de TEST
# Chargé par .github/workflows/generate-test.yml.
# Les GetCapabilities appelés sont toujours ceux de production.
# Format : CLE=valeur, une par ligne (pas de guillemets, pas d'espaces autour du =).

# Configuration éditoriale par défaut : chemin d'un fichier du repo ou URL.
# Peut être surchargée au lancement du workflow (input « edito_source »).
EDITO_SOURCE=edito/edito-test.json

# Branche sur laquelle les fichiers générés sont publiés
DIST_BRANCH=dist-test

# Nombre maximum de commits conservés sur DIST_BRANCH (historique tronqué au-delà)
MAX_COMMIT=10
